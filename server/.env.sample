# Server Configuration
PORT=8000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/mockmate
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mockmate?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
BCRYPT_SALT_ROUNDS=10
ADMIN_SECRET=mockmate_super_admin_secret_key_2026

# AI & LLM Engine
GEMINI_API_KEY=your_gemini_api_key_here

# Code Execution Sandbox (Optional fallback: https://emkc.org/api/v2/piston)
PISTON_API_URL=https://emkc.org/api/v2/piston

# AWS S3 / Object Storage (for video recordings, reports, and resumes)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=mockmate-recordings-bucket

# Email Notifications (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@mockmate.ai
